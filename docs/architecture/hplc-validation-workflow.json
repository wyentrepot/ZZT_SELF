    { "id": "report-inconclusive", "from": "report", "to": "inconclusive", "label": "inconclusive", "role": "branch", "variant": "dashed" },
    { "id": "report-error", "from": "report", "to": "error", "label": "error", "role": "error", "variant": "security" },
    { "id": "run-cancel", "from": "run", "to": "report", "label": "协作式取消：cancelling → cancelled", "role": "branch", "variant": "dashed", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "labelSegment": 1 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "采集与解析事实",
      "items": [
        "WorkBench 通过 /api/listener 进行进程内 ASGI 前缀转发",
        "PySerial 字节流按 0x7E 切帧，先写会话日志，再批量写入 SQLite frames / minute_reports",
        "解析优先本地 .NET DLL，退化为远程 HTTP /api/version + /api/parse；均不可用仍继续采集入库"
      ]
    },
    {
      "dot": "violet",
      "title": "追踪与组网派生",
      "items": [
        "Frame 入库回调推动 TraceService live cursor / replay / ACK 配对",
        "NwkService 对 frames 增量 decode_frame，生成 nwk_events / nwk_scan_state"
      ]
    },
    {
      "dot": "amber",
      "title": "结论边界",
      "items": [
        "Run 后台顺序：flash → monitor → stimulus → compare → feedback → evidence/report",
        "无证据进入 inconclusive，不把证据不足误判为 failed；Report 是派生结果，Evidence 与 Artifact 清单是审计基础"
      ]
    }
  ]
}
