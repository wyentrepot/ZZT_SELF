  "cards": [
    {
      "dot": "cyan",
      "title": "统一入口与控制面",
      "items": [
        "Workbench 聚合 UI、FastAPI、三个子应用与验证 API；AI API v1/v2 负责授权边界。",
        "AIControlService 通过进程内注入复用 listener、module_log、simcon，UI 和 AI 不直接打开串口。"
      ]
    },
    {
      "dot": "emerald",
      "title": "三类现场能力",
      "items": [
        "侦听台持续保留原始 LOG 与 SQLite frames；本地 .NET DLL → Windows 远程 parser_service 失败时仍可采集。",
        "模块日志覆盖 CCO / STA 调试与 XMODEM；模拟集中器在 HPLC / 1376.2 总线上执行激励和自动应答。"
      ]
    },
    {
      "dot": "violet",
      "title": "验证证据闭环",
      "items": [
        "RunExecutor 的三源适配语义为：listener 只读 SQLite frames，loghooks 读取模块日志，simcon 调用 execute_task。",
        "Evidence freeze 后形成 Assertion、Report、Artifact；证据和产物保持可追溯、可审计。"
      ]
    },
    {
      "dot": "amber",
      "title": "资源与台架边界",
      "items": [
        "SerialResourceRegistry 是进程级物理串口句柄登记；ResourceLeaseManager 是 Run 级逻辑租约，不能混为一谈。",
        "实验台把侦听串口、CCO / STA 调试串口和 HPLC / 1376.2 物理总线分成三条链路。"
      ]
    }
  ]
