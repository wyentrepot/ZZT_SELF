{
  "id": "archive_multi",
  "title": "多档下发（同一建档块实例化两次，各下发一块不同表地址的档案；仅用于单测）",
  "kind": "regression",
  "category": {
    "usage": "rare",
    "domain": "CCO",
    "scene": "档案",
    "region": "国网通用"
  },
  "protocols": [
    "1376.2"
  ],
  "steps": [
    {
      "no": 1,
      "do": "下发第一块表的从节点档案（同一建档块第 1 次实例化）",
      "expect": "拿到观测（写入确认字段在观测里）"
    },
    {
      "no": 2,
      "do": "下发第二块表的从节点档案（同一建档块第 2 次实例化，参数不同）",
      "expect": "拿到观测；两块表的档案地址不同"
    },
    {
      "no": 3,
      "do": "本流程只用于单测：证明同一块在一条流程里能按不同参数实例化多次（0042 变更 3）",
      "expect": "台架只有 1 块真表、本流程真机不跑；真机验收走 meter_smoke_min（meter_daily）/ smoke_meter（meter_first_join）"
    }
  ],
  "needs": [
    "bench.simcon_online"
  ],
  "plan": [
    {
      "id": "add_a",
      "block": "archive.add",
      "params": {
        "meter_addr": "000000000011"
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "got"
        }
      ],
      "note": "第一块表：失败也让第二步照跑（on_fail=continue）"
    },
    {
      "id": "add_b",
      "block": "archive.add",
      "params": {
        "meter_addr": "000000000022"
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "got"
        }
      ],
      "note": "第二块表：仅单测（台架无第二块表）"
    }
  ],
