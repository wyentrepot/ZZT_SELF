  "steps": [
    {
      "no": 1,
      "do": "下发从节点档案（11H-F1 建档，幂等）",
      "expect": "写入确认=确认（已存在跳过下发也算确认）"
    },
    {
      "no": 2,
      "do": "查询档案表确认档案落地（10H-F2）",
      "expect": "档案表含该表档案地址（观测完整）"
    },
    {
      "no": 3,
      "do": "周期性查询网络拓扑（10H-F21）直到入网达标或等满预算 300 秒（等待期只发只读查询）",
      "expect": "在网从节点数 ≥ ceil(档案数×98%) 且观测翻页取全 → 入网成立；等满仍明确不足 → 判不成立；档案数=0 或取不到 → 说不清"
    }
  ],
  "needs": [
    "bench.simcon_online"
  ],
