{
  "id": "meter_daily",
  "title": "抄表日常回归（不复位，日常）：档案 → 查档 → 组网 → 绑表 → 抄表",
  "kind": "regression",
  "category": {
    "usage": "common",
    "domain": "CCO",
    "scene": "抄表",
    "region": "国网通用"
  },
  "protocols": [
    "1376.2",
    "645"
  ],
  "steps": [
    {
      "no": 1,
      "do": "下发从节点档案（11H-F1 建档，幂等：档案已存在时跳过下发）。本流程不复位 STA：日常回归假定链路已在网",
      "expect": "建档命令被接受（写入确认=确认；已存在跳过下发也算确认）→ 进入查档步；否认/没等到 → 断点=①；台架不具备 → 阻断"
    },
    {
      "no": 2,
      "do": "查询档案表确认档案真的落地（10H-F2，翻页取全）——「回了确认却没落地」的唯一出口（0044 §8.1 第1条 查档必备步）",
      "expect": "档案表含本表档案地址（观测完整）→ 进入组网；明确不含 → 判不成立（防假通过）；查不全 → 不完整，不得折算成含或不含"
    },
    {
      "no": 3,
      "do": "查询网络拓扑判定入网（10H-F21，等待预算 300 秒、每 2 秒只读查询，达标即停）",
      "expect": "在网从节点数 ≥ 门槛（ceil(档案数×98%)，单表 ≥1）且观测翻页取全 → 组网状态成立；等满预算仍不足 → 判不成立；档案数=0 或取不到应答 → 说不清"
    },
    {
      "no": 4,
      "do": "绑表：透传 645 读通信地址（13H）取本表地址，单次上限 15s、等待预算 60s（写死在本流程）。本步只证明「STA 能取到表地址」，不是抄表",
      "expect": "内层 645 地址域与本表地址一致 → STA 能取到表地址；不符 → 断点（地址口径/档案）；等满一帧没有 → 链路未恢复（台架侧，说不清）"
    },
    {
      "no": 5,
      "do": "抄读正向有功总电能（11H，DI 00010000，单次上限 15s、等待预算 30s——写死在本流程）",
      "expect": "收到帧 + CS 合法 + 非异常应答 + DI 回显 + 数值可解（不比对数值真值，0044 §8.1 第4条）；不符 → 断点"
    },
    {
      "no": 6,
      "do": "抄读 A 相电压（11H，DI 02010100，单次上限 15s、等待预算 30s——写死在本流程）。瞬时量，比电能更能证明「这一次真的读到了表内数据」",
      "expect": "收到帧 + CS 合法 + 非异常应答 + DI 回显 + 数值可解（不比对数值真值）"
    }
  ],
  "needs": [
    "bench.simcon_online"
  ],
  "plan": [
    {
      "id": "s1",
      "block": "archive.add",
      "params": {},
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "写入确认",
          "value": "确认"
        }
      ]
    },
    {
      "id": "s1b",
      "block": "archive.query",
      "params": {
        "meter_addr": null
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "在档",
          "value": true
        }
      ],
      "note": "查档必备步（0044 §8.1 第1条）：档案落地由查询独立证明"
    },
    {
      "id": "s2",
      "block": "nwk.topology",
      "params": {
        "wait_s": 300
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "ge_field",
          "field": "在网从节点数",
          "value": "门槛"
        }
      ],
      "note": "等待预算写死在本流程（0044 §8.1 第3条）"
    },
    {
      "id": "s3",
      "block": "meter.addr_probe",
      "params": {
        "expect_timeout": 15,
        "wait_s": 60
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "地址一致",
          "value": true
        }
      ]
    },
    {
      "id": "s4",
      "block": "meter.read_645",
      "params": {
        "di": "00010000",
        "expect_timeout": 15,
        "wait_s": 30
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "CS合法",
          "value": true
        },
        {
          "op": "eq",
          "field": "异常应答",
          "value": false
        },
        {
          "op": "eq",
          "field": "DI回显",
          "value": true
        },
        {
          "op": "has_value",
          "field": "数值"
        }
      ],
      "note": "电能：只验「有值且可解」，不比对 1234.56 真值（0044 §8.1 第4条）"
    },
    {
      "id": "s5",
      "block": "meter.read_645",
      "params": {
        "di": "02010100",
        "expect_timeout": 15,
        "wait_s": 30
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "CS合法",
          "value": true
        },
        {
          "op": "eq",
          "field": "异常应答",
          "value": false
        },
        {
          "op": "eq",
          "field": "DI回显",
          "value": true
        },
        {
          "op": "has_value",
          "field": "数值"
        }
      ],
      "note": "电压：同上"
    }
  ],
  "asserts": [],
