{
  "id": "meter_first_join",
  "title": "首次组网流程测试",
  "description": "首次组网流程用例：复位 STA 后经建档、组网、绑表完成首次抄表",
  "kind": "regression",
  "category": {
    "usage": "common",
    "domain": "CCO",
    "scene": "抄表",
    "region": "国网通用"
  },
  "protocols": [
    "1376.2",
    "645"
  ],
  "steps": [
    {
      "no": 1,
      "do": "复位 STA（经 STA 控制台口下发 reboot）。只在首次组网/换板/台架重上电时用；日常回归走 meter_daily（不复位）。真机教训：复位后链路恢复要十几分钟量级，而单次读取只要 2.3～2.6s",
      "expect": "下发时刻之后的 STA 会话日志命中重启指纹 → 复位成立（沿用复位块自带判据，未迁移）。复位成立不代表链路已恢复"
    },
    {
      "no": 2,
      "do": "下发从节点档案（11H-F1 建档，幂等）。先复位再建档，避免把复位打断造成的异常算到档案头上",
      "expect": "写入确认=确认（已存在跳过下发也算确认）"
    },
    {
      "no": 3,
      "do": "查询档案表确认档案落地（10H-F2）",
      "expect": "档案表含本表档案地址（观测完整）"
    },
    {
      "no": 4,
      "do": "查询网络拓扑判定入网（10H-F21，预算 300s，只读轮询）",
      "expect": "在网从节点数 ≥ 门槛且观测取全；注意复位后计数残留会让本步立刻成立——链路真可用由第 5~7 步证明"
    },
    {
      "no": 5,
      "do": "绑表：透传 645 13H 取本表地址，单次上限 15s、等待预算 180s（写死在本流程，复位后链路恢复是分钟级）",
      "expect": "内层 645 地址域与本表地址一致；等满一帧没有 → 链路尚未恢复（台架侧，说不清）"
    },
    {
      "no": 6,
      "do": "抄读正向有功总电能（11H，DI 00010000，单次上限 15s、预算 30s）",
      "expect": "收到帧 + CS 合法 + 非异常应答 + DI 回显 + 数值可解（不比对数值真值）"
    },
    {
      "no": 7,
      "do": "抄读 A 相电压（11H，DI 02010100，单次上限 15s、预算 30s）。瞬时量，比电能更能证明「这一次真的读到了表内数据」",
      "expect": "收到帧 + CS 合法 + 非异常应答 + DI 回显 + 数值可解（不比对数值真值）"
    }
  ],
  "needs": [
    "bench.sta_online",
    "bench.simcon_online"
  ],
  "plan": [
    {
      "id": "s1",
      "block": "reset.sta",
      "params": {},
      "on_fail": "stop",
      "expect": [],
      "note": "复位块未迁移（第二批）：沿用块内判据（重启指纹）；复位成立 ≠ 链路已恢复"
    },
    {
      "id": "s2",
      "block": "archive.add",
      "params": {},
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "写入确认",
          "value": "确认"
        }
      ]
    },
    {
      "id": "s2b",
      "block": "archive.query",
      "params": {
        "meter_addr": null
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "在档",
          "value": true
        }
      ]
    },
    {
      "id": "s3",
      "block": "nwk.topology",
      "params": {
        "wait_s": 300
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "ge_field",
          "field": "在网从节点数",
          "value": "门槛"
        }
      ],
      "note": "复位后 CCO 节点计数残留：组网判定通过 ≠ 链路可用，链路可用由绑表/抄表证明"
    },
    {
      "id": "s4",
      "block": "meter.addr_probe",
      "params": {
        "expect_timeout": 15,
        "wait_s": 180
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "地址一致",
          "value": true
        }
      ],
      "note": "复位后链路恢复分钟级：等待预算 180s 写死在本流程"
    },
    {
      "id": "s5",
      "block": "meter.read_645",
      "params": {
        "di": "00010000",
        "expect_timeout": 15,
        "wait_s": 30
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "CS合法",
          "value": true
        },
        {
          "op": "eq",
          "field": "异常应答",
          "value": false
        },
        {
          "op": "eq",
          "field": "DI回显",
          "value": true
        },
        {
          "op": "has_value",
          "field": "数值"
        }
      ]
    },
    {
      "id": "s6",
      "block": "meter.read_645",
      "params": {
        "di": "02010100",
        "expect_timeout": 15,
        "wait_s": 30
      },
      "on_fail": "stop",
      "expect": [
        {
          "op": "complete"
        },
        {
          "op": "eq",
          "field": "CS合法",
          "value": true
        },
        {
          "op": "eq",
          "field": "异常应答",
          "value": false
        },
        {
          "op": "eq",
          "field": "DI回显",
          "value": true
        },
        {
          "op": "has_value",
          "field": "数值"
        }
      ]
    }
  ],
  "asserts": [],
