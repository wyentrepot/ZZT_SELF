{
  "id": "fix.simeter_session",
  "title": "台架：模拟电表表口打开并能应答（没开就开，开完不关；只报观测不判定）",
  "needs": [],
  "provides": [
    "bench.simeter_online"
  ],
  "action": {
    "kind": "probe_bench",
    "capability": "simeter",
    "mapping_id": "listener",
    "probe_timeout": 5.0,
    "params": {
      "ensure_open": true,
      "port": "simeter"
    }
  },
  "assert": [
    {
      "type": "observation_fields",
      "fields": [
        "就绪",
        "串口开",
        "开口动作"
      ],
      "note": "判据在步骤期望（就绪=true 由调用方要求）；开口失败按原因码上报"
    }
  ],
  "tags": [
    "bench",
    "first-batch"
  ],
  "kind": "setup",
  "side_effect": "reversible",
  "version": 2,
  "observation_only": true
}
