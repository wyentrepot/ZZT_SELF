{
  "id": "meter.addr_probe",
  "title": "STA 获取表地址（02H-F1 透传 645 13H；只报观测：内层 645 地址/协议类型，不判地址对错）",
  "needs": [
    "bench.simcon_online",
    "nwk.joined"
  ],
  "provides": [
    "sta.addr_obtained"
  ],
  "action": {
    "afn": "02",
    "fn": 1,
    "params": {
      "protocol": 2,
      "meter_addr": null,
      "addr_mode": "meter",
      "wait_s": 0,
      "poll_interval_s": 5
    }
  },
  "assert": [
    {
      "type": "observation_fields",
      "fields": [
        "请求表地址",
        "内层645地址",
        "地址一致",
        "外层协议类型"
      ],
      "note": "判据在步骤期望（内层地址=期望表地址 由调用方声明）"
    }
  ],
  "tags": [
    "meter",
    "645",
    "smoke"
  ],
  "kind": "case",
  "side_effect": "none",
  "version": 2,
  "observation_only": true,
  "wait_param": "wait_s"
}
