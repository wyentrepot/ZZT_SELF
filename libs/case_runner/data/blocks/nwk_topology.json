{
  "id": "nwk.topology",
  "title": "查询网络拓扑信息（10H-F21 翻页拉全节点；只报观测：节点数/主节点数/门槛，不判达标与否）",
  "needs": [
    "bench.simcon_online",
    "archive.written"
  ],
  "provides": [
    "nwk.joined"
  ],
  "action": {
    "afn": "10",
    "fn": 21,
    "params": {
      "start": 1,
      "count": 32,
      "wait_s": 300.0,
      "poll_interval_s": 2.0,
      "min_ratio": 0.98,
      "master_included": false
    }
  },
  "assert": [
    {
      "type": "observation_fields",
      "fields": [
        "节点总数量",
        "主节点数",
        "在网从节点数",
        "档案数",
        "门槛",
        "完整"
      ],
      "note": "判据在步骤期望（在网从节点数 ≥ 门槛，门槛由块按 min_ratio 从观测算出）"
    }
  ],
  "tags": [
    "nwk",
    "readonly",
    "online"
  ],
  "kind": "case",
  "side_effect": "none",
  "version": 2,
  "observation_only": true,
  "wait_param": "wait_s"
}
