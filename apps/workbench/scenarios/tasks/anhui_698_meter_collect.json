{
  "id": "anhui_698_meter_collect",
  "name": "安徽 698 电表采集验证（添加档案 + 配置任务 + 主动上报捕捉）",
  "profile": "anhui",
  "module": "cco",
  "port": "COM19",
  "baudrate": 9600,
  "enable_responder": true,
  "description": "模拟集中器经 COM19 与安徽 CCO 交互：1) 添加 698 协议从节点（地址 080000000000，旧验证帧实际字节 08 00 00 00 00 00）；2) 配置采集任务 1（协议698/周期1分钟/采集A相电压 20000201）；3) 等待 CCO 主动上报 06H-F230 采集数据。帧为单 68 标准帧，用例语义化（ADR-5）：send 仅写 afn/fn + 业务参数，构帧由 scenario_codec 完成。",
  "responders": [
    {
      "id": "anhui.ack.meter",
      "match": {"afn": 6, "fn": 230},
      "reply": {"afn": 0, "fn": 1, "format": "local", "desc": "采集数据上报→回确认"}
    }
  ],
  "steps": [
    {
      "name": "添加 698 从节点档案 (11H-F1, 地址 080000000000)",
      "send": {
        "afn": "11",
        "fn": "F1",
        "params": {"action": "add", "addr": "080000000000", "protocol": 3}
      },
      "expect": {"format": "local", "afn": 0, "fn": 1},
      "expect_timeout": 5.0
    },
    {
      "name": "配置采集任务 (11H-F231, 任务1/698/周期1分钟/A相电压)",
      "send": {
        "afn": "11",
        "fn": "F231",
        "params": {
          "task_no": 1,
          "action": "enable",
          "protocol": 3,
          "cycle_min": 1,
          "items": [{"meter_type": 0, "item": "20000201", "reply_len": 1}]
        }
      },
      "expect": {"format": "local", "afn": 17, "fn": 231},
      "expect_timeout": 5.0
    },
    {
      "name": "关联档案到任务 (11H-F232, 任务1/电表080000000000)",
      "send": {
        "afn": "11",
        "fn": "F232",
        "params": {"task_no": 1, "meters": ["080000000000"]}
      },
      "expect": {"format": "local", "afn": 17, "fn": 232},
      "expect_timeout": 5.0
    },
    {
      "name": "等待 CCO 上报采集数据 (06H-F230, 历史查询)",
      "recv_only": true,
      "expect_history": true,
      "expect": {"format": "local", "afn": 6, "fn": 230},
      "expect_timeout": 90.0
    }
  ]
}
